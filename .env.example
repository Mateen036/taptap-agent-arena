# Vercel runtime; use the connected database integration for actual values.
POSTGRES_URL=
AUTH_SECRET=
# Optional BNB Chain RPC and future token operator public address.
BSC_RPC_URL=
ADMIN_WALLET=

# Nib Collection: public contract addresses; keep unset until mainnet deployment is verified.
NFT_COLLECTION=
NFT_MARKETPLACE=
NFT_LP_VAULT=
# Collection-wide bids (NibCollectionBids). Keep unset until the contract is deployed and verified: the feature stays hidden and refuses requests while unset.
NFT_COLLECTION_BIDS=
# Treasury-managed NIB vault V2 (NibVaultV2). Keep unset until deployed and verified: the refund/treasury disclosure on the NFT page stays hidden while unset.
NIB_VAULT_V2=
# Nib Collection V2 (airdropped replacement of the old collection). When NFT_COLLECTION_V2 is set the site shows ONLY V2 and hides the old collection (mint, gallery, market, bids, game gate, NIB bonus).
# It requires NFT_MARKETPLACE_V2 and NIB_VAULT_V2 as well (otherwise the NFT page fails closed); NFT_COLLECTION_BIDS_V2 is optional. Set them only AFTER finalizeAirdrop. NFT_COLLECTION, NFT_MARKETPLACE, NFT_LP_VAULT and NFT_COLLECTION_BIDS are ignored while V2 is set.
NFT_COLLECTION_V2=
NFT_MARKETPLACE_V2=
NFT_COLLECTION_BIDS_V2=
# Optional: must match the immutable marketplace fee recipient. Defaults to NFT_LP_VAULT.
NFT_FEE_RECIPIENT=

# Keep unset until the reviewed utility activation procedure completes.
# Persistent nft_utility_v2 activation is authoritative even if this flag is absent.
NFT_GAME_UTILITY=

# NIB pre-market (bid-only NIB order book). Leave NIB_BID_MARKET unset until the contract is deployed and verified;
# the site shows "not live yet" meanwhile. Set NIB_MARKET_FROM_BLOCK to the deployment block so fill history is indexed from there.
NIB_BID_MARKET=
NIB_MARKET_FROM_BLOCK=

# Bug Bounty (NibBugBounty escrow). The whole feature is hidden and every endpoint refuses requests while BUG_BOUNTY_CONTRACT is unset.
# Set it only after the contract is deployed and verified (docs/nib/BUG_BOUNTY.md).
BUG_BOUNTY_CONTRACT=
# 64 hex characters (32 random bytes). Encrypts vulnerability reports at rest (AES-256-GCM). Without it, reports cannot be submitted. Never commit it.
BUG_BOUNTY_REPORT_KEY=
